{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpriteBook Studio",
  "version": "0.1.0",
  "identifier": "dev.spritebook.studio",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist",
    "beforeDevCommand": "deno task dev:web",
    "beforeBuildCommand": "deno task build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SpriteBook Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
