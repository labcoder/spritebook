{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpriteBook Studio",
  "version": "0.9.0",
  "identifier": "dev.spritebook.studio",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm --prefix ../.. run dev:desktop:web",
    "beforeBuildCommand": "npm --prefix ../.. run prepare:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SpriteBook Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../../.build/runtime/": "runtime/"
    }
  }
}
