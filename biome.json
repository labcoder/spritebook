{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/target",
      "!.render-bench",
      "!spikes",
      "!docs/internal",
      "!packages/schema/fixtures/valid",
      "!packages/schema/fixtures/migrate",
      "!packages/anim/packs",
      "!packages/rig/bodies",
      "!packages/registry/catalog",
      "!future/baseline",
      "!future/qualification"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": {
        "noAssignInExpressions": "off"
      },
      "style": {
        "useTemplate": "off"
      }
    }
  }
}
