{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/target",
      "!.render-bench",
      "!spikes",
      "!docs/internal",
      "!packages/schema/fixtures/valid",
      "!packages/schema/fixtures/migrate",
      "!packages/anim/packs",
      "!packages/rig/bodies",
      "!packages/registry/catalog",
      "!future/baseline",
      "!future/qualification",
      "!.build"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        "noNonNullAssertedOptionalChain": "off",
        "noShadowRestrictedNames": "off",
        "noImplicitAnyLet": "off",
        "noConfusingLabels": "off"
      },
      "style": {
        "useTemplate": "off",
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "useOptionalChain": "off",
        "noCommaOperator": "off"
      },
      "preset": "recommended"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "css": {
    "linter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/studio/src/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "preset": "none"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "suspicious": {
            "noCommentText": "off",
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ]
}
