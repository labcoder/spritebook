{
  "workspace": [
    "./packages/schema",
    "./packages/core",
    "./packages/importer",
    "./packages/render",
    "./packages/style",
    "./packages/anim",
    "./packages/gen",
    "./packages/rig",
    "./packages/pack",
    "./packages/export",
    "./packages/registry",
    "./packages/cli"
  ],
  "nodeModulesDir": "auto",
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "exclude": [
      "packages/schema/fixtures",
      "packages/anim/packs",
      "packages/registry/catalog",
      "packages/rig/bodies"
    ]
  },
  "lint": {
    "rules": { "tags": ["recommended"] },
    "exclude": ["spikes"]
  },
  "unstable": ["webgpu"],
  "exclude": ["spikes/shell/app/dist", "spikes/shell/app/node_modules", "spikes/autorig/UniRig"],
  "tasks": {
    "dev": "deno test --watch --watch-exclude=node_modules --allow-read --allow-write --allow-env --allow-ffi --allow-net=127.0.0.1 --allow-run=nvidia-smi,uv",
    "test": "deno test --allow-read --allow-write --allow-env --allow-ffi --allow-net=127.0.0.1 --allow-run=nvidia-smi,uv",
    "test:gpu": "SPRITEBOOK_REQUIRE_GPU=1 deno test --allow-read --allow-write --allow-env --allow-ffi packages/render/ packages/style/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "coverage": "deno test --allow-read --allow-write --allow-env --allow-ffi --coverage=.coverage && deno coverage .coverage",
    "goldens:update": "deno run --allow-read --allow-write --allow-env --allow-ffi packages/style/fixtures/_gen-goldens.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "spike:webgpu": "deno run --unstable-webgpu --allow-read=spikes/webgpu --allow-write=spikes/webgpu --allow-env spikes/webgpu/main.ts",
    "spike:webgpu:gen": "deno run --allow-read=spikes/webgpu --allow-write=spikes/webgpu spikes/webgpu/gen-asset.ts"
  }
}
