  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node",
      "@webgpu/types"
    ],
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "ESNext.Array"
    ]
  }
}
