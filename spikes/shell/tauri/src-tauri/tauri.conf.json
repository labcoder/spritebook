{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spritebook-shell-spike",
  "version": "0.0.0",
  "identifier": "dev.spritebook.shellspike",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist",
    "beforeDevCommand": "deno task --cwd ../app dev",
    "beforeBuildCommand": "deno task --cwd ../app build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SpriteBook shell spike (Tauri)",
        "width": 1100,
        "height": 820,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
